# Copy to .env (cp .env.example .env) — .env is git-ignored.

# Your school's Canvas URL, no trailing path. e.g. https://myschool.instructure.com
VITE_CANVAS_BASE_URL=https://yourschool.instructure.com

# OPTIONAL, local dev convenience only. Skips the login screen.
# WARNING: anything prefixed VITE_ is inlined into the JS bundle at build time.
# Never deploy a build made with a real token here. Leave blank and paste the
# token into the login screen instead if unsure.
VITE_CANVAS_API_TOKEN=

# Set to true if the browser reports CORS errors. Routes requests through the
# Vite dev server (dev only). Restart `npm run dev` after changing this.
# Also needed for file previews at schools that block CORS. While true, every
# Canvas call goes to VITE_CANVAS_BASE_URL above, whatever address is typed on
# the login screen.
VITE_USE_DEV_PROXY=false

# OPTIONAL. `api` makes `npm run dev` and `npm run build` the API-token edition
# (token sign-in only, no browser extension), as on the main branch. Read by
# vite.config.ts only; not put in the bundle. Ignored by tests.
# COURSELINE_EDITION=api

# Optional: sign in with Microsoft (Settings → Connection), for the People tab's emails and OneDrive submissions.
# The app registration's "Application (client) ID" (Single-page application, redirect URI http://localhost:5173), and
# the school's Microsoft directory (tenant) ID; leave the tenant out to accept any work or school account.
# VITE_MS_CLIENT_ID=
# VITE_MS_TENANT_ID=
