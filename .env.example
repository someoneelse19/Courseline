# Copy to .env (cp .env.example .env) — .env is git-ignored.

# Your school's Canvas URL, no trailing path. e.g. https://myschool.instructure.com
VITE_CANVAS_BASE_URL=https://yourschool.instructure.com

# OPTIONAL, local dev convenience only. Skips the login screen.
# WARNING: anything prefixed VITE_ is inlined into the JS bundle at build time.
# Never deploy a build made with a real token here. Leave blank and paste the
# token into the login screen instead if unsure.
VITE_CANVAS_API_TOKEN=

# Set to true if the browser reports CORS errors. Routes requests through the
# Vite dev server (dev only). Restart `npm run dev` after changing this.
VITE_USE_DEV_PROXY=false
