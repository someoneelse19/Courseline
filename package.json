{
  "name": "better-canvas",
  "private": true,
  "version": "0.1.0",
  "description": "A faster, cleaner web client for Canvas LMS: course pages and modules in one view, an in-app file viewer, and an in-depth grades page.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
